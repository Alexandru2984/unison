[Unit]
Description=Unison Idea Evolution backend (isolated)
Wants=network-online.target
After=network-online.target
# Every release links its own hash-locked venv and names its engine runtime in
# runtime.env, both under /opt/unison-runtime; the development checkout is not
# visible to the service.
ConditionFileIsExecutable=/opt/unison-backend/current/venv/bin/uvicorn
ConditionPathExists=/opt/unison-backend/current/evolution.uc
ConditionPathExists=/opt/unison-backend/current/runtime.env

[Service]
Type=simple
User=unisonapp
Group=unisonapp
WorkingDirectory=/opt/unison-backend/current
Environment=HOME=/var/lib/unison-backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DOTENV_DISABLED=1
Environment=DB_PATH=/var/lib/unison-backend/evolution.db
Environment=UNISON_PROGRAM=/opt/unison-backend/current/evolution.uc
Environment=PUBLIC_ORIGIN=https://unison.micutu.com
Environment=ENABLE_API_DOCS=false
# Sets APP_REVISION and UNISON_BIN for the active release.
EnvironmentFile=/opt/unison-backend/current/runtime.env
Environment=MAX_IDEAS=10000
Environment=MAX_RESULTS=500
Environment=MUTATION_TIMEOUT_SECONDS=5
ExecStart=/opt/unison-backend/current/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8097 --workers 1 --ws websockets --timeout-graceful-shutdown 8 --ws-max-size 1024 --timeout-keep-alive 5 --limit-concurrency 96 --backlog 64 --no-access-log
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077

StateDirectory=unison-backend
StateDirectoryMode=0700
RuntimeDirectory=unison-backend
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=4096
TasksMax=64
CPUQuota=100%
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
